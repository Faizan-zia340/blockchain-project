pragma solidity ^0.8.20;

// LearnTypes — Solidity ke basic types
contract LearnTypes {
    // Numbers
    uint256 public myUint = 42;
    int256 public myInt = -10;
    // Text
    string public myString = "Hello Faizy";
    // True / False
    bool public myBool = true;
    // Address (wallet / contract ka pata)
    address public myAddress = 0x5B38Da6a701c568545dCfcB03FcB875f56beddC4;
    // Bytes
    bytes32 public myBytes = "abc";
}

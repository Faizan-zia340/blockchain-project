# .env — apni asli values se bharo, phir file ka naam `.env` rakh do
# YE FILE KABHI GITHUB PAR NAHI DALNI — .gitignore mein hai.

# Sepolia RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# EIP-3009: jis account ke paas USDC hai (Account 2)
HOLDER_PRIVATE_KEY=0x...

# EIP-3009: jo gas dega (Account 1 ya 3)
RELAYER_PRIVATE_KEY=0x...

# Foundry deploy ke liye (Account 2)
PRIVATE_KEY=0x...

# Etherscan key (optional — deploy verify ke liye; abhi use nahi ho raha)
ETHERSCAN_API_KEY=
